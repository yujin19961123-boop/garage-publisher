# Copy to .env. Change both passwords before starting.
# This value is embedded in a connection URL: use URL-safe letters/digits/-/_ .
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PUBLIC_SCHEME=http
PUBLIC_DOMAIN=localhost
PUBLIC_PORT=8080
HTTP_PORT=8080
ADMIN_HOSTS=console.localhost,127.0.0.1
PUBLIC_URL_MODE=path
CONSOLE_URL=http://console.localhost:8080
