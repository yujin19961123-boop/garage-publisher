# Shared-origin mode: only this explicitly configured host can reach the service.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${ADMIN_DOMAIN};
    root /usr/share/nginx/html;
    client_max_body_size 101m;
    client_body_timeout 600s;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-store always;
    location /api/ {
        proxy_pass http://app:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
    location = /healthz {
        proxy_pass http://app:8081;
        proxy_set_header Host $http_host;
    }
    location = / { try_files /index.html =404; }
    location /assets/ { try_files $uri =404; }
    # Every other path, including /_share/, is resolved by the application.
    # Never fall back to the administration index for prototype URLs.
    location / {
        proxy_pass http://app:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 600s;
    }
}
