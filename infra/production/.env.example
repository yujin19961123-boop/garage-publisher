# Copy to .env on the server only; do not commit the resulting file.
# The two values below are placeholders, not usable production credentials.
# Generate different strong passwords; POSTGRES_PASSWORD must be URL-safe.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_64_HEX_DATABASE_PASSWORD
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
ADMIN_DOMAIN=garage.byjin.cn
HTTP_PORT=18080
# Shared-origin mode is explicitly enabled in compose.yml.
